PORT=5000
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/cvboostDB
JWT_SECRET=your-jwt-secret-here
JWT_REFRESH_SECRET=your-jwt-refresh-secret-here
GROQ_API_KEY=gsk_your-groq-api-key
NODE_ENV=development

# The app's own public origin, used for CORS and for the links inside
# password-reset and email-verification messages. Leave both unset in production:
# the app falls back to RENDER_EXTERNAL_URL, which Render injects into every
# service, so a deploy is correct without manual configuration. Set them only to
# override -- e.g. to allow several CORS origins (comma-separated), or when the
# frontend is served from a different host than the API.
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# PostHog analytics (optional — server-side events; frontend uses VITE_POSTHOG_KEY)
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com

# Sentry (optional — error tracking)
SENTRY_DSN=

# Google OAuth
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# CamPay
CAMPAY_API_URL=https://api.campay.net/api
CAMPAY_SANDBOX_USERNAME=
CAMPAY_SANDBOX_PASSWORD=
CAMPAY_USERNAME=
CAMPAY_PASSWORD=
CAMPAY_WEBHOOK_SECRET=

# Email (optional — emails log to console if not set)
#
# Preferred: Brevo's HTTPS API on port 443. Set this and the SMTP_* values below
# are ignored. Required on hosts that block outbound SMTP — Render free
# instances block ports 25/465/587, so SMTP there can only time out.
# BREVO_API_KEY=xkeysib-your-key
#
# SMTP_FROM must be an address verified as a sender in Brevo, otherwise sends
# are rejected regardless of which transport is used.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CVBoost <noreply@cvboost.app>

# Job scraper (optional — Cameroon job board listings)
# JOB_SCRAPING_ENABLED=false disables the in-process scheduler entirely.
# JOB_SCRAPE_KEY lets an external cron hit POST /api/jobs/scrape with header x-scrape-key.
#   It must match the JOB_SCRAPE_KEY secret on the deployed app, and it fails
#   closed: if unset, the route only accepts session-authenticated admins.
# JOB_ENRICH_DETAILS=false skips fetching each listing's detail page (slower but richer data).
# JOB_ENRICH_MAX caps how many detail pages are fetched per source per cycle.
# JOB_SCRAPE_TIMEOUT_MS / JOB_DETAIL_TIMEOUT_MS tune the per-request timeouts.
#   A non-numeric value falls back to the default rather than silently disabling work.
# JOB_EXPIRY_DAYS is how long a listing stays on the board after it was last seen
#   by a scrape. Age is measured from scrapedAt, not postedAt, because most of
#   these boards publish no date and a postedAt-based sweep would let a
#   still-listed old job flip between active and expired on every cycle.
#   Expiry only sets active:false -- nothing is ever deleted, and a listing that
#   reappears on its source board is reactivated automatically. Set to 0 to turn
#   the sweep off.
JOB_SCRAPING_ENABLED=true
JOB_SCRAPE_INTERVAL_MINUTES=360
JOB_SCRAPE_KEY=
JOB_ENRICH_DETAILS=true
JOB_ENRICH_MAX=12
JOB_SCRAPE_TIMEOUT_MS=30000
JOB_DETAIL_TIMEOUT_MS=45000
JOB_EXPIRY_DAYS=30

# AI model used by aiService / linkedinService
AI_MODEL=openai/gpt-oss-120b

# Optional card payment providers. Each is advertised by /api/payments/providers
# only when its key is present, so an unset key cleanly disables that provider.
PAYSTACK_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional revenue reporting. With both unset, reports are no-ops.
CMO_ENDPOINT=
CMO_REVENUE_KEY=

# Optional: BetterStack log drain + log directory (default "logs")
BETTERSTACK_SOURCE_TOKEN=
LOG_DIR=logs
