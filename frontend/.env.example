# Frontend build-time variables. Only VITE_* keys are exposed to the browser
# bundle — anything Vite inlines here is public, so never put a secret in a
# VITE_ key.

VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Analytics (optional)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_SENTRY_DSN=

# 'production' or 'development'
VITE_APP_ENV=development
