# NOTE: Docker's .dockerignore uses Go filepath.Match against paths relative to
# the context root, so a bare `node_modules` or `.env` matches ONLY the root
# entry. Anything that must be excluded everywhere needs a `**/` prefix.

**/node_modules
**/.env
**/.env.*
**/dist
**/__tests__
**/tests
**/*.log
**/coverage
**/test-results
**/playwright-report
**/.git
**/.vscode
**/.idea
**/.DS_Store
render.yaml
.gitignore
