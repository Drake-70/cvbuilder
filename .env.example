# Backend Environment Variables — copy to .env and fill in values

PORT=5000
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/cvboostDB?appName=Cluster0
JWT_SECRET=<generate-64-char-random-string>
JWT_REFRESH_SECRET=<generate-another-64-char-random-string>
GROQ_API_KEY=gsk_...
CORS_ORIGIN=https://yourdomain.com
NODE_ENV=production
FRONTEND_URL=https://yourdomain.com

# Google OAuth
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# CamPay (sandbox)
CAMPAY_API_URL=https://api.campay.net/api
CAMPAY_SANDBOX_USERNAME=your-sandbox-username
CAMPAY_SANDBOX_PASSWORD=your-sandbox-password

# CamPay (production)
CAMPAY_USERNAME=your-live-username
CAMPAY_PASSWORD=your-live-password
CAMPAY_WEBHOOK_SECRET=your-webhook-secret

# SMTP / Email (optional — emails log to console if not set)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=CVBoost <noreply@cvboost.app>

# Job scraper. See backend/.env.example for the full set of tuning knobs.
# JOB_SCRAPE_KEY is the shared secret the GitHub Actions cron
# (.github/workflows/jobs-scrape.yml) sends as the x-scrape-key header.
JOB_SCRAPING_ENABLED=true
JOB_SCRAPE_INTERVAL_MINUTES=360
JOB_ENRICH_DETAILS=true
JOB_SCRAPE_KEY=

# Analytics (optional)
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com
SENTRY_DSN=
BETTERSTACK_SOURCE_TOKEN=

# Revenue reporting (optional)
CMO_ENDPOINT=
CMO_REVENUE_KEY=
